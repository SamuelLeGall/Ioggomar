{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "node",
    "importHelpers": true,
    "jsx": "preserve",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "baseUrl": "./",
    "paths": {
      "@src/*": [
        "src/*"
      ],
    },
    "strict": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "types": ["vitest/globals"]
  },
  "include": [ "src/**/*",  "tests/**/*"],
  "exclude": ["node_modules", "dist", "build"],
  "references": [
    {
      "path": "./tsconfig.node.json"
    }
  ]
}